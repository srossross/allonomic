{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "fs:default",
    "dialog:default",
    "log:default",
    {
      "identifier": "fs:allow-read",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$HOME/**/.allonomic"
        },
        {
          "path": "$HOME/**/.allonomic/**"
        },
        {
          "path": "$APPCONFIG/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$HOME/**/.allonomic"
        },
        {
          "path": "$HOME/**/.allonomic/**"
        },
        {
          "path": "$APPCONFIG/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$HOME/**/.allonomic"
        },
        {
          "path": "$HOME/**/.allonomic/**"
        },
        {
          "path": "$APPCONFIG/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$HOME/**/.allonomic"
        },
        {
          "path": "$HOME/**/.allonomic/**"
        },
        {
          "path": "$APPCONFIG/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$HOME/**/.allonomic"
        },
        {
          "path": "$HOME/**/.allonomic/**"
        },
        {
          "path": "$APPCONFIG/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/**"
        },
        {
          "path": "$HOME/**/.allonomic"
        },
        {
          "path": "$HOME/**/.allonomic/**"
        },
        {
          "path": "$APPCONFIG/**"
        }
      ]
    },
    "fs:allow-appconfig-read-recursive",
    "fs:allow-appconfig-write-recursive",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "docker",
          "cmd": "docker",
          "args": true
        },
        {
          "name": "sandbox-exec",
          "cmd": "/usr/bin/sandbox-exec",
          "args": true
        }
      ]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "**"
        },
        {
          "path": "$HOME/**"
        }
      ]
    }
  ]
}